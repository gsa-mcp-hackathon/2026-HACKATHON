{
  "datasets": [
    {
      "name": "fema_pa",
      "displayName": "FEMA PA Funded Projects",
      "config": {
        "source": "workspace.default.funded_projects_details",
        "measures": [
          {
            "name": "total_obligated",
            "expr": "SUM(totalObligated)",
            "displayName": "Total Obligated",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          },
          {
            "name": "project_count",
            "expr": "COUNT(1)",
            "displayName": "Project Count",
            "format": {
              "type": "number",
              "abbreviation": "compact"
            }
          },
          {
            "name": "avg_project_amount",
            "expr": "SUM(totalObligated) / COUNT(1)",
            "displayName": "Avg Obligated per Project",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          }
        ],
        "version": "1.1",
        "comment": "FEMA Public Assistance funded projects (OpenFEMA, declarations since 2021)",
        "dimensions": [
          {
            "name": "state",
            "expr": "stateAbbreviation",
            "displayName": "State"
          },
          {
            "name": "incident_type",
            "expr": "incidentType",
            "displayName": "Incident Type"
          },
          {
            "name": "declaration_year",
            "expr": "YEAR(declarationDate)",
            "displayName": "Declaration Year",
            "format": {
              "type": "number",
              "hideGroupSeparator": true
            }
          },
          {
            "name": "declaration_year_date",
            "expr": "DATE_TRUNC('YEAR', declarationDate)",
            "displayName": "Declaration Year (Date)"
          },
          {
            "name": "project_label",
            "expr": "CONCAT('DR-', CAST(disasterNumber AS STRING), ' PW ', CAST(pwNumber AS STRING), ' | ', stateAbbreviation, ' | ', COALESCE(applicationTitle, 'Untitled'))",
            "displayName": "Project"
          }
        ]
      }
    }
  ],
